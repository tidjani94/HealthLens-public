{
  "name": "tidjani94/healthlens",
  "description": "HealthLens WordPress Site Health Monitor",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "1.0.0",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "php-stubs/wordpress-stubs": "^6.8",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "scripts": {
    "lint": "@php bin/lint.php",
    "dashboard:audit": "@php bin/dashboard-audit.php",
    "readme:audit": "@php bin/readme-audit.php",
    "public:export": "@php bin/public-export.php",
    "public:link-audit": "@php bin/public-link-audit.php",
    "release:version": "@php bin/release-version-audit.php",
    "package:audit": "@php bin/package-audit.php",
    "plugin-check:audit": "@php bin/plugin-check-audit.php",
    "release:gate": "@php bin/release-gate.php",
    "phpcs": "phpcs --standard=phpcs.xml.dist",
    "phpcbf": "phpcbf --standard=phpcs.xml.dist",
    "phpstan": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1024M",
    "test": "phpunit --configuration=phpunit.xml.dist",
    "test:unit": "phpunit --configuration=phpunit.xml.dist --testsuite=unit",
    "check": [
      "@composer validate --strict",
      "@lint",
      "@dashboard:audit",
      "@readme:audit",
      "@release:version",
      "@release:gate",
      "@phpcs",
      "@phpstan",
      "@test:unit"
    ],
    "package": "@php build/package.php"
  },
  "autoload": {
    "psr-4": {
      "HealthLens\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4.0"
    }
  }
}
